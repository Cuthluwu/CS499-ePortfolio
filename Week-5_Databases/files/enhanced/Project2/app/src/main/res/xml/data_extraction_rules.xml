<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Application backup is disabled in AndroidManifest.xml to avoid exporting local account data. -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
